APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/voice_assistance
REDIS_URL=redis://localhost:6379/0

# Authentication settings. Generate a unique random value for local use.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=voice-assistance
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Phase 4 remote transcription API settings.
STT_ENGINE=remote
STT_API_URL=https://skin-technologies-strategies-membership.trycloudflare.com/v1/audio/transcriptions
STT_API_KEY=replace-with-a-rotated-stt-api-key
STT_API_AUTH_HEADER=Authorization
STT_API_AUTH_SCHEME=Bearer
STT_API_MODEL=
STT_API_FILE_FIELD=file
STT_API_FILENAME=audio.wav
STT_API_RESPONSE_FORMAT=json
STT_API_LANGUAGE=en
STT_API_CONNECT_TIMEOUT_SECONDS=10
STT_API_TIMEOUT_SECONDS=60
STT_API_MAX_RESPONSE_BYTES=4194304

# Temporary migration fallback. Do not use this for remote acceptance.
# Self-contained publish output; no interactive DOTNET_ROOT is required.
STT_WINDOWS_WORKER_PATH=backend/windows_stt/publish/WindowsSttWorker.exe
# Only needed when deliberately configuring a framework-dependent .dll.
STT_DOTNET_PATH=
STT_WINDOWS_LANGUAGE=en-US
STT_START_TIMEOUT_SECONDS=10
STT_FINAL_TIMEOUT_SECONDS=30
STT_WORKER_TIMEOUT_SECONDS=5
# Temporary one-turn physical diagnostic; keep disabled for normal runs.
STT_DIAGNOSTIC_CAPTURE_ENABLED=false
STT_DIAGNOSTIC_CAPTURE_DIR=scratch/phase4_stt_diagnostics

# Optional legacy Whisper adapter settings. These are not used when STT_ENGINE=remote.
STT_MODEL_PATH=models/whisper-large-v3-turbo-ct2
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=
STT_BEAM_SIZE=5
STT_WORKERS=1
STT_TIMEOUT=180
STT_PARTIAL_INTERVAL_SECONDS=2
STT_PARTIAL_WINDOW_SECONDS=30
STT_MAX_AUDIO_SECONDS=120
STT_MAX_ACTIVE_TURNS=4

# Phase 5 LLM settings. All four values must be configured together.
# Keep LLM_API_KEY only in the ignored .env file or a production secret manager.
LLM_PROVIDER=nvidia
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=replace-with-a-rotated-nvidia-api-key
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RESPONSE_BYTES=8388608
LLM_MAX_SSE_EVENT_BYTES=262144
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_CONTEXT_TOKENS=32768
LLM_MAX_CONCURRENT_REQUESTS=8
LLM_MAX_TOOL_ROUNDS=4
LLM_MAX_TOOL_CALLS=8
LLM_MAX_TOOL_WALL_TIME_SECONDS=30
LLM_MAX_TOOL_RESULT_CHARS=16384
LLM_MAX_RETRY_ATTEMPTS=2
LLM_ANTHROPIC_VERSION=2023-06-01

# Optional local backend listener settings
HOST=0.0.0.0
PORT=8000
BACKEND_PORT=8000

# Phase 3 voice gateway protocol limits.
VOICE_PROTOCOL_VERSION=1
VOICE_SAMPLE_RATE_HZ=16000
VOICE_CHANNELS=1
VOICE_FRAME_SAMPLES=320
VOICE_FRAME_BYTES=640
VOICE_HEARTBEAT_INTERVAL_SECONDS=15
VOICE_HEARTBEAT_TIMEOUT_SECONDS=45
VOICE_MAX_SESSION_SECONDS=1800
VOICE_MAX_TURN_SECONDS=120
VOICE_IDLE_TIMEOUT_SECONDS=90
VOICE_MAX_FRAME_BYTES=4096
VOICE_MAX_CONTROL_BYTES=16384
VOICE_QUEUE_CAPACITY_FRAMES=100
VOICE_RECONNECT_GRACE_SECONDS=30
