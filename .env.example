APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/voice_assistance
REDIS_URL=redis://localhost:6379/0

# Authentication settings. Generate a unique random value for local use.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=voice-assistance
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Optional local backend listener settings
HOST=0.0.0.0
PORT=8000
BACKEND_PORT=8000

# Phase 3 voice gateway protocol limits.
VOICE_PROTOCOL_VERSION=1
VOICE_SAMPLE_RATE_HZ=16000
VOICE_CHANNELS=1
VOICE_FRAME_SAMPLES=320
VOICE_FRAME_BYTES=640
VOICE_HEARTBEAT_INTERVAL_SECONDS=15
VOICE_HEARTBEAT_TIMEOUT_SECONDS=45
VOICE_MAX_SESSION_SECONDS=1800
VOICE_MAX_TURN_SECONDS=120
VOICE_IDLE_TIMEOUT_SECONDS=90
VOICE_MAX_FRAME_BYTES=4096
VOICE_MAX_CONTROL_BYTES=16384
VOICE_QUEUE_CAPACITY_FRAMES=100
VOICE_RECONNECT_GRACE_SECONDS=30
